# Stock footage for --style footage (free key: pixabay.com/api/docs)
PIXABAY_API_KEY=

# Optional: text the post kit + video to this iMessage number after each render (macOS only)
IMESSAGE_TO=

# Optional: YouTube upload. Run `npm run yt-auth -- <client_secret.json>` to fill these in.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# public | unlisted | private (unaudited API projects are forced to private)
YT_PRIVACY=private

# Optional: path to an ffmpeg binary
FFMPEG=
